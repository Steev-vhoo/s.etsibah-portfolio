# Server-side only (set these in Vercel → Project → Settings → Environment Variables)
GOOGLE_API_KEY=your-google-cloud-api-key
# Folder ID from https://drive.google.com/drive/folders/<FOLDER_ID>  (folder must be shared "Anyone with the link")
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id
# Optional — found automatically from youtubeChannelUrl in src/data/site.js
# YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx
